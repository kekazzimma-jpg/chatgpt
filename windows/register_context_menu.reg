Windows Registry Editor Version 5.00

; Aggiorna il percorso exe prima di importare.

[HKEY_CLASSES_ROOT\*\shell\P7MPortableExtractor]
@="Apri con P7M Portable Extractor"
"Icon"="C:\\Tools\\p7m-portable.exe"

[HKEY_CLASSES_ROOT\*\shell\P7MPortableExtractor\command]
@="\"C:\\Tools\\p7m-portable.exe\" \"%1\""
